{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerDesk",
  "version": "0.1.0",
  "identifier": "com.serverdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "服务器控制中心",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d1015"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/serverdesk-channel"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
